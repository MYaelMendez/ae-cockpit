{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae.studio/schemas/zygotae.genesis.v1.json",
  "title": "ZYGOTÆ Genome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "principal_ref",
    "purpose",
    "identity",
    "template",
    "capabilities",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "zygotae.genesis.v1"
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:_./-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_may_propagate",
        "authority_may_propagate"
      ],
      "properties": {
        "context_may_propagate": {
          "const": true
        },
        "authority_may_propagate": {
          "const": false
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
