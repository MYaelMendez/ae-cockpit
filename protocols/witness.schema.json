{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Witness Receipt",
  "type": "object",
  "required": [
    "intent",
    "status"
  ],
  "properties": {
    "intent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "executed",
        "failed"
      ]
    },
    "principal": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}